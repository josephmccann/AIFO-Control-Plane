{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getaifo.com/engineering-os/v1/airtable-record.schema.json",
  "title": "AI.FO Airtable Reporting Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "direction", "mission_id", "repository", "state", "risk_tier", "head_sha", "projected_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "source": {"const": "github"}, "direction": {"const": "github_to_airtable"}, "mission_id": {"type": "string", "minLength": 1}, "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"}, "state": {"enum": ["Proposed", "Ready", "Claimed", "In Progress", "Adversarial Review", "Founder Approval", "Merge Authorized", "Merged", "Verified", "Closed", "Parked", "Incident", "Cancelled"]}, "risk_tier": {"enum": ["Tier 0", "Tier 1", "Tier 2"]}, "head_sha": {"type": ["string", "null"]}, "projected_at": {"type": "string", "minLength": 1}
  }
}
