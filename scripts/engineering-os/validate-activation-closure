def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT, text=True).strip()


def digest_at(revision, path):
    return hashlib.sha256(
        subprocess.check_output(["git", "show", "%s:%s" % (revision, path)], cwd=ROOT)
    ).hexdigest()


def governed_file(path, expected_path=None):
    if not isinstance(path, str) or ".." in Path(path).parts or Path(path).is_absolute():
        raise SystemExit("evidence path is not governed")
    if expected_path is not None and path != expected_path:
        raise SystemExit("evidence path is not canonical")
    target = ROOT / path
    if not target.is_file():
        raise SystemExit("evidence is missing: %s" % path)
    try:
        target.resolve().relative_to(ROOT.resolve())
    except ValueError:
        raise SystemExit("evidence escapes the repository: %s" % path)
    return target


def tracked_evidence(path, expected_path=None):
    if not isinstance(path, str) or ".." in Path(path).parts or Path(path).is_absolute():
        raise SystemExit("evidence path is not governed")
    if expected_path is not None and path != expected_path:
        raise SystemExit("evidence path is not canonical")
    try:
        entry = git("ls-tree", "HEAD", "--", path)
    except subprocess.CalledProcessError:
        raise SystemExit("evidence is missing from the attestation revision: %s" % path)
    fields = entry.split(None, 3)
    if len(fields) != 4 or fields[0] not in {"100644", "100755"} or fields[1] != "blob" or fields[3] != path:
        raise SystemExit("evidence is not one regular tracked file: %s" % path)
    try:
        return subprocess.check_output(["git", "show", "HEAD:%s" % path], cwd=ROOT)
    except subprocess.CalledProcessError:
        raise SystemExit("evidence blob cannot be read: %s" % path)


def file_record(path):
    relative = path.resolve().relative_to(ROOT.resolve()).as_posix()
    return {"path": relative, "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}


def verify_file_record(record, expected_path=None):
    if not isinstance(record, dict) or set(record) != {"path", "sha256"}:
        raise SystemExit("evidence record is malformed")
    data = tracked_evidence(record.get("path"), expected_path)
    if hashlib.sha256(data).hexdigest() != record.get("sha256"):
        raise SystemExit("evidence digest is stale: %s" % record.get("path"))
    return data


