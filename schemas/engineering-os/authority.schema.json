{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getaifo.com/engineering-os/v1/authority.schema.json",
  "title": "AI.FO Mission Authority",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "authority_id", "repository", "paths", "capabilities", "issuer", "subject", "mission_id", "pull_request", "head_sha", "starts_at", "expires_at", "status", "nonce", "single_use", "source"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "record_id": {"type": "string", "minLength": 1}, "authority_id": {"type": "string", "minLength": 1}, "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"}, "paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["read", "write", "merge", "deploy", "cloud_mutation", "secrets", "customer_data", "spend", "cutover"]}}, "issuer": {"type": "string", "minLength": 1}, "subject": {"type": "string", "minLength": 1}, "mission_id": {"type": "string", "minLength": 1}, "pull_request": {"type": "integer", "minimum": 1}, "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "starts_at": {"type": "string", "minLength": 1}, "expires_at": {"type": "string", "minLength": 1}, "status": {"enum": ["active", "expired", "revoked", "consumed"]}, "nonce": {"type": "string", "minLength": 1}, "single_use": {"const": true},
    "source": {"type": "object", "additionalProperties": false, "required": ["provider", "record_kind", "payload_sha256", "repository", "issue_number", "comment_id", "url", "actor", "created_at"], "properties": {"provider": {"const": "github"}, "record_kind": {"const": "authority"}, "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"}, "issue_number": {"type": "integer", "minimum": 1}, "comment_id": {"type": "integer", "minimum": 1}, "url": {"type": "string", "minLength": 1}, "actor": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "minLength": 1}}}
  }
}
