{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getaifo.com/engineering-os/v1/approval.schema.json",
  "title": "AI.FO Founder Approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_id", "approval_id", "status", "mission_id", "action", "repository", "pull_request", "head_sha", "environment", "merge_method", "issuer", "approved_at", "expires_at", "deployment_authorized", "cutover_authorized", "nonce", "single_use", "source"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "minLength": 1},
    "approval_id": {"type": "string", "minLength": 1},
    "status": {"const": "approved"},
    "mission_id": {"type": "string", "minLength": 1},
    "action": {"enum": ["merge", "deploy", "cutover", "cloud_mutation", "spend", "exception"]},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "pull_request": {"type": "integer", "minimum": 1},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment": {"type": "string", "minLength": 1},
    "merge_method": {"enum": ["merge", "squash", "rebase"]},
    "issuer": {"type": "string", "minLength": 1},
    "approved_at": {"type": "string", "minLength": 1},
    "expires_at": {"type": "string", "minLength": 1},
    "deployment_authorized": {"type": "boolean"},
    "cutover_authorized": {"type": "boolean"},
    "nonce": {"type": "string", "minLength": 1},
    "single_use": {"const": true},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "record_kind", "payload_sha256", "repository", "subject_kind", "subject_number", "comment_id", "url", "actor", "created_at", "content_sha256", "head_sha", "transport_provenance"],
      "properties": {
        "provider": {"const": "github"},
        "record_kind": {"const": "founder_approval"},
        "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "subject_kind": {"enum": ["issue", "pull_request"]},
        "subject_number": {"type": "integer", "minimum": 1},
        "comment_id": {"type": "integer", "minimum": 1},
        "url": {"type": "string", "minLength": 1},
        "actor": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "minLength": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "transport_provenance": {"type": "string", "minLength": 1}
      }
    }
  }
}
