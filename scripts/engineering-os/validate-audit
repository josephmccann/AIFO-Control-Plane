#!/usr/bin/env bash
set -euo pipefail
exec python3 - "$@" <<'PY'
"""Validate an Engineering OS audit chain from a JSON file."""

import argparse
import json

from engineering_os.audit import validate_audit_chain


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("audit_file")
    args = parser.parse_args()
    try:
        with open(args.audit_file, encoding="utf-8") as handle:
            events = json.load(handle)
        decision = validate_audit_chain(events)
        print(json.dumps({
            "allowed": decision.allowed,
            "code": decision.code,
            "head_hash": decision.head_hash,
        }, sort_keys=True, separators=(",", ":")))
        return 0 if decision.allowed else 1
    except (OSError, ValueError, json.JSONDecodeError):
        print('{"allowed":false,"code":"AUDIT_INPUT_INVALID","head_hash":null}')
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
PY
