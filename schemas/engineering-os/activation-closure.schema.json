{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getaifo.com/engineering-os/v1/activation-closure.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mission", "base", "final", "files", "edges", "pins", "tests", "evidence", "reviews"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "mission": {"type": "object", "additionalProperties": false, "required": ["repository", "issue", "declaration_path", "declaration_sha256", "ready_declaration_sha256", "allowed_paths"], "properties": {"repository": {"const": "josephmccann/AIFO-Control-Plane"}, "issue": {"const": 31}, "declaration_path": {"const": "outputs/successor-mission-declaration.md"}, "declaration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "ready_declaration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "base": {"type": "object", "additionalProperties": false, "required": ["sha", "tree"], "properties": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "final": {"type": "object", "additionalProperties": false, "required": ["sha", "tree"], "properties": {"sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "files": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "reason"], "properties": {"path": {"type": "string", "pattern": "^[^/].+$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "reason": {"type": "string", "minLength": 1}}}},
    "edges": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["from", "to", "kind"], "properties": {"from": {"type": "string", "minLength": 1}, "to": {"type": "string", "minLength": 1}, "kind": {"enum": ["materializes", "pins", "tests", "documents", "validates"]}}}},
    "pins": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["consumer", "sha"], "properties": {"consumer": {"type": "string", "minLength": 1}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}},
    "tests": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["command", "result", "head", "evidence_path", "evidence_sha256"], "properties": {"command": {"type": "string", "minLength": 1}, "result": {"const": "pass"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "evidence_path": {"type": "string", "minLength": 1}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "reviews": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["reviewer", "checkpoint", "head", "critical", "important", "report_path", "report_sha256"], "properties": {"reviewer": {"type": "string", "minLength": 1}, "checkpoint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "critical": {"const": 0}, "important": {"const": 0}, "report_path": {"type": "string", "minLength": 1}, "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
