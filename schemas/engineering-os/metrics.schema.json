{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getaifo.com/engineering-os/v1/metrics.schema.json",
  "title": "AI.FO Engineering Metrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "period_start", "period_end", "founder_minutes", "lifecycle_seconds", "model_cost_usd", "model_tokens", "findings", "remediation_cycles", "defects", "parked", "orphaned", "false_positive_blocks", "overrides", "rollbacks", "incidents", "throughput"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "period_start": {"type": "string", "minLength": 1}, "period_end": {"type": "string", "minLength": 1}, "founder_minutes": {"type": "number", "minimum": 0}, "lifecycle_seconds": {"type": "object"}, "model_cost_usd": {"type": "number", "minimum": 0}, "model_tokens": {"type": "integer", "minimum": 0}, "findings": {"type": "object"}, "remediation_cycles": {"type": "integer", "minimum": 0}, "defects": {"type": "integer", "minimum": 0}, "parked": {"type": "integer", "minimum": 0}, "orphaned": {"type": "integer", "minimum": 0}, "false_positive_blocks": {"type": "integer", "minimum": 0}, "overrides": {"type": "integer", "minimum": 0}, "rollbacks": {"type": "integer", "minimum": 0}, "incidents": {"type": "integer", "minimum": 0}, "throughput": {"type": "integer", "minimum": 0}
  }
}
