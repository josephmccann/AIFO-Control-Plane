    {
      "name": "infrastructure",
      "paths": [
        ".github/workflows/**",
        "scripts/**",
        "terraform/**"
      ],
      "minimum_tier": "Tier 2",
      "owners": [
        "josephmccann"
      ],
      "conflict_group": "control-plane-infrastructure"
    },
    {
      "name": "security",
      "paths": [
        "SECURITY.md",
        "docs/security-model.md",
        "docs/runbooks/emergency-access.md"
      ],
      "minimum_tier": "Tier 2",
      "owners": [
        "josephmccann"
      ],
      "conflict_group": "security-boundary"
    }
  ],
  "tier_2_paths": [
    ".aifo/**",
    ".github/**",
    "AGENTS.md",
    "SECURITY.md",
    "docs/adr/**",
    "docs/engineering-os/**",
    "docs/governance/**",
