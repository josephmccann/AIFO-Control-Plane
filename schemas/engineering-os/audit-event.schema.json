{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.getaifo.com/engineering-os/v1/audit-event.schema.json",
  "title": "AI.FO Audit Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mission_id", "sequence", "type", "actor", "actor_role", "occurred_at", "source_url", "previous_event_hash", "event_hash", "details"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "mission_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "actor_role": {"enum": ["producer", "adversary", "founder", "system"]},
    "occurred_at": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "minLength": 1},
    "previous_event_hash": {"type": ["string", "null"]},
    "event_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "details": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "test_integrity.baseline.authorized"}}},
      "then": {
        "properties": {
          "actor_role": {"const": "founder"},
          "details": {
            "type": "object",
            "required": ["repository", "mission_issue", "remediation_head", "remediation_tree", "baseline_artifact_sha256", "canonical_inventory_sha256", "baseline_generator_identity", "analyzer_identity", "workflow_identity", "caller_identity", "immutable_kernel_identity", "manifest_identity", "rollback_sha", "activation_nonce", "activation_type", "single_use", "founder_authorization_identity", "founder_authorization_sequence"],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"enum": ["test_integrity.baseline.consumption_attempted", "test_integrity.baseline.consumed"]}}},
      "then": {
        "properties": {
          "actor_role": {"const": "system"},
          "details": {
            "type": "object",
            "required": ["repository", "mission_issue", "remediation_head", "remediation_tree", "baseline_artifact_sha256", "canonical_inventory_sha256", "baseline_generator_identity", "analyzer_identity", "workflow_identity", "caller_identity", "immutable_kernel_identity", "manifest_identity", "rollback_sha", "activation_nonce", "activation_type", "single_use", "founder_authorization_identity", "founder_authorization_sequence", "authorization_event_hash", "authorization_sequence", "consumer_identity", "consumed_at", "consumption_result", "post_consumption_state", "attempt_event_hash"],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
