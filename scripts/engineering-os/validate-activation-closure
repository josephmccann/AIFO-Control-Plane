    if complete_lines != (["Validation complete"] if expected_terminal is None else []):
        raise SystemExit("CI evidence completion status contradicts its terminal result")
    outcomes = [line for line in evidence_lines if line == "OK" or line == "FAILED" or line.startswith("FAILED (")]
    if outcomes != ["OK"]:
        raise SystemExit("CI evidence deterministic test outcome is contradictory")
    if len([line for line in evidence_lines if re.fullmatch(r"Ran [1-9][0-9]* tests in .+", line)]) != 1:
        raise SystemExit("CI evidence does not contain an exact deterministic test result")


def verify_materialization_range(final_head, materialization_head):
    """Require one evidence-only child after the reviewed implementation parent."""
    if (git("rev-parse", final_head) != final_head
            or git("rev-parse", materialization_head) != materialization_head):
        raise SystemExit("closure materialization revisions must be full commit SHAs")
    topology = git("rev-list", "--parents", "-n", "1", materialization_head).split()
    if len(topology) == 2:
        if os.environ.get("GITHUB_ACTIONS") == "true":
            raise SystemExit("CI closure materialization requires the exact protected-base merge candidate")
        evidence_child = materialization_head
    elif len(topology) == 3:
        if os.environ.get("GITHUB_ACTIONS") == "true" and os.environ.get(
                "GITHUB_EVENT_NAME") not in {"pull_request", "push"}:
            raise SystemExit("CI closure materialization has an unauthorized workflow event")
        # Successor PRs are based on the already-merged Control Plane default
        # branch, while the historical closure remains anchored to Mission 32's
        # original rollback base. Accept either authenticated protected parent;
        # reject every other topology.
        protected_parents = {PR_BASE["sha"]}
        try:
            protected_parents.add(git("rev-parse", "origin/main"))
        except Exception:
            pass
        if topology[1] not in protected_parents:
            raise SystemExit("closure merge candidate has the wrong protected-base parent")
        evidence_child = topology[2]
        if git("rev-parse", "%s^{tree}" % materialization_head) != git(
                "rev-parse", "%s^{tree}" % evidence_child):
            raise SystemExit("closure merge candidate tree differs from the evidence child")
    else:
        raise SystemExit("closure materialization has an unsupported parent topology")
    evidence_topology = git("rev-list", "--parents", "-n", "1", evidence_child).split()
    if len(evidence_topology) != 2 or evidence_topology[1] != final_head:
        raise SystemExit("closure materialization must be the direct child of the reviewed head")
    changed = set(git(
        "diff-tree", "--no-commit-id", "--name-only", "-r", evidence_child,
    ).splitlines())
    if not changed or not changed <= MATERIALIZATION_PATHS:
        raise SystemExit("closure materialization child contains non-evidence changes")


# Successor records pin exact reviewed content for the range from the closure
# head.  Successive missions extend that same range, so each contributes its
# own records file and a later mission supersedes an earlier pin for any path
# it re-touches.  Order matters: later entries win.
SUCCESSOR_RECORDS_PATHS = (
    "outputs/mission-35-closure-records.json",
    "outputs/mission-36-closure-records.json",
    "outputs/mission-38-closure-records.json",
    "outputs/mission-40-closure-records.json",
    "outputs/mission-41-closure-records.json",
    "outputs/mission-46-closure-records.json",
    "outputs/mission-48-closure-records.json",
    "outputs/mission-50-closure-records.json",
)


def successor_record_paths(changed):
    """Paths whose exact reviewed content the successor records must pin."""
    return sorted(
        path for path in changed
        if path not in MATERIALIZATION_PATHS and path not in SUCCESSOR_RECORDS_PATHS
    )


def verify_successor_records(changed, successor_head):
    """Pin the successor range to exact reviewed content, not just path names.

    A path-name allow-list alone lets any later commit edit an already-allowed
    path -- ``engineering_os/commands.py`` or the mission-command workflow --
    and still validate under stale mission authority, with no fresh records,
    evidence, or review.  Recording the exact blob of every changed path forces
    that edit to fail closed until the records are refreshed, which is a
    visible, reviewable act.

    The records live outside the paths they pin, so committing them cannot
    invalidate their own contents.
    """
    tracked = successor_record_paths(changed)
    if not tracked:
        return
    recorded = {}
    found = False
    for records_path in SUCCESSOR_RECORDS_PATHS:
        try:
            layer = json.loads(git("show", "%s:%s" % (successor_head, records_path)))
        except Exception:
            continue
        if not isinstance(layer, dict):
            raise SystemExit("successor records are malformed")
        # A later mission supersedes an earlier pin for any path it re-touches.
        recorded.update(layer)
        found = True
    if not found:
        raise SystemExit("successor records are missing at the successor head")
    if sorted(recorded) != tracked:
        raise SystemExit("successor records do not pin exactly the changed paths")
    for path in tracked:
        try:
            blob = git("rev-parse", "%s:%s" % (successor_head, path))
        except Exception:
            raise SystemExit("successor records reference a missing path")
        if recorded[path] != blob:
            raise SystemExit("successor content does not match the reviewed records")


def verify_successor_head(final_head, successor_head):
    """Preserve a reviewed closure while validating a descendant successor."""
    if git("merge-base", final_head, successor_head) != final_head:
        raise SystemExit("closure successor is not descended from the reviewed head")
    # Diff from the reviewed closure head, not from origin/main.  Once this
    # lands, an up-to-date checkout has origin/main == successor_head, which
    # yields an empty diff and would reject the successor -- making the normal
    # local validation entrypoint impossible to run from a clean checkout.
    # "What has this successor changed since the reviewed closure" is the
    # question that actually bounds re-review, and it does not depend on where
    # any remote ref happens to point.
    changed = set(git("diff", "--name-only", final_head, successor_head).splitlines())
    # The range from the reviewed closure head necessarily contains the closure
    # materialization child, which adds exactly the reviewed evidence paths.
    # Those are part of the reviewed closure, not undeclared successor drift.
    if not changed or not changed <= (SUCCESSOR_ALLOWED_PATHS | MATERIALIZATION_PATHS):
        raise SystemExit("successor changed an undeclared path")
    verify_successor_records(changed, successor_head)
    # Re-validate the closure's own content and hashes at the reviewed head;
    # successor implementation commits may carry refreshed historical evidence.
    validate(Path(CLOSURE_PATH), final_head)


def exact_status_lines(text, expected, reconciliation=False):
    """Accept one closed status footer and reject prefixes, duplicates, or contradictions."""
    lines = text.splitlines()
    for prefix, value in expected.items():
        matching = [line for line in lines if line.startswith(prefix)]
        if matching != [value]:
            raise SystemExit("review status evidence is missing, duplicated, or contradictory")
    if reconciliation:
        matching = [line for line in lines if line.startswith("Reconciliation:")]
        if matching != ["Reconciliation: PASS"]:
            raise SystemExit("reconciliation verdict is missing, duplicated, or contradictory")
    else:
        verdicts = [line for line in lines if line in {"PASS", "FAIL"} or line.startswith("Verdict:")]
        if verdicts != ["PASS"]:
            raise SystemExit("review verdict is missing, duplicated, or contradictory")


def generate(base, head, records_path):
    """Emit canonical closure JSON; claims come only from explicit governed records."""
    if base != BASE_SHA:
        raise SystemExit("generation base is not the Mission 32 rollback/base")
    if git("rev-parse", head) != head:
        raise SystemExit("generation head must be a full commit SHA")
    if records_path.resolve() != (ROOT / RECORDS_PATH).resolve():
        raise SystemExit("generation records path is not governed")
    records = json.loads(governed_file(RECORDS_PATH).read_text(encoding="utf-8"))
    if set(records) != {
        "allowed_paths", "historical", "tests", "reviews", "reconciliation",
        "bootstrap_disposition",
    }:
        raise SystemExit("generation records structure is not closed")
    if sorted(records.get("allowed_paths", [])) != AUTHORIZED_PATHS:
        raise SystemExit("generation scope does not match Mission 32 Ready authority")
    changed = sorted(filter(None, git("diff", "--name-only", base, head).splitlines()))
    if not set(changed) <= set(AUTHORIZED_PATHS):
        raise SystemExit("implementation contains a path outside Mission 32 authority")
    closure = {
        "schema_version": "1.0.0",
        "mission": MISSION,
        "historical": records["historical"],
        "base": {"sha": base, "tree": git("rev-parse", "%s^{tree}" % base)},
        "final": {"sha": head, "tree": git("rev-parse", "%s^{tree}" % head)},
        "files": [
            {"path": path, "sha256": digest_at(head, path), "reason": "Mission 32 implementation"}
            for path in changed
        ],
        "edges": expected_edges(changed),
        "pins": [],
        "classification": CLASSIFICATION,
        "bootstrap_disposition": records["bootstrap_disposition"],
        "records": file_record(records_path),
        "tests": records["tests"],
        "evidence": records["historical"]["mission_31"]["evidence"],
        "reviews": records["reviews"],
        "reconciliation": records["reconciliation"],
    }
    print(json.dumps(closure, sort_keys=True, indent=2))
    return 0


def validate(path, head):
    closure = json.loads(path.read_text(encoding="utf-8"))
    violations = validate_document("activation-closure", closure)
    if violations:
        raise SystemExit("activation closure schema rejected: " + "; ".join(item.code for item in violations))
    if set(closure) not in {frozenset(TOP_LEVEL), frozenset(LEGACY_TOP_LEVEL)}:
        raise SystemExit("closure top-level structure is not closed")
    if closure.get("mission") != MISSION:
        raise SystemExit("Mission 32 Ready identity or scope is not canonical")
    final = closure.get("final", {})
    if final.get("sha") != head or git("rev-parse", head) != head or final.get("tree") != git("rev-parse", "%s^{tree}" % head):
        raise SystemExit("closure final revision mismatch")
    base = closure.get("base", {})
    if base.get("sha") != BASE_SHA or git("rev-parse", "%s^{tree}" % BASE_SHA) != base.get("tree"):
        raise SystemExit("closure base is not the Mission 32 rollback/base")
    changed = set(git("diff", "--name-only", BASE_SHA, head).splitlines())
    records = closure.get("files")
    if not isinstance(records, list) or {item.get("path") for item in records} != changed:
        raise SystemExit("closure file set is missing, extra, or stale")
    if not (changed | {CLOSURE_PATH}) <= set(AUTHORIZED_PATHS):
        raise SystemExit("closure contains a path outside Mission 32 authority")
    for item in records:
        if (set(item) != {"path", "sha256", "reason"}
                or item.get("reason") != "Mission 32 implementation"
                or item.get("sha256") != digest_at(head, item.get("path"))):
            raise SystemExit("closure file digest mismatch: %s" % item.get("path"))
    edges = expected_edges(changed)
    if not edges or closure.get("edges") != edges:
        raise SystemExit("closure dependency edges are incomplete or contradictory")
    if closure.get("pins") != []:
        raise SystemExit("Mission 32 must not claim transport pins")
    if closure.get("classification") != CLASSIFICATION:
        raise SystemExit("classification rules are not canonical and fail-closed")

    disposition = closure.get("bootstrap_disposition")
    if disposition is None:
        if head != LEGACY_CLOSURE_HEAD:
            raise SystemExit("bootstrap disposition is required after the legacy closure")
        integrity = {}
    else:
        integrity = validate_bootstrap_disposition(disposition, final, head)

    historical = closure.get("historical", {}).get("mission_31", {})
    historical_identity = {key: value for key, value in historical.items() if key != "evidence"}
    if historical_identity != HISTORICAL_IDENTITY:
        raise SystemExit("Mission 31 historical identity is not canonical")
    historical_evidence = historical.get("evidence", [])
    if {item.get("path") for item in historical_evidence} != HISTORICAL_EVIDENCE_PATHS:
        raise SystemExit("Mission 31 historical evidence set is incomplete")
    for item in historical_evidence:
        verify_file_record(item)
    if closure.get("evidence") != historical_evidence:
        raise SystemExit("historical evidence binding is contradictory")

    verify_file_record(closure.get("records"), RECORDS_PATH)
    tests = closure.get("tests", [])
    if len(tests) != 1:
        raise SystemExit("closure requires one exact-head CI validation record")
    test = tests[0]
    expected_result = "pass" if disposition is None else "expected_materialization_denial"
    if (test.get("head") != head or test.get("command") != "validate-all"
            or test.get("result") != expected_result
            or test.get("workflow_path") != ".github/workflows/terraform-validate.yml"
            or not isinstance(test.get("run_id"), int) or test["run_id"] < 1
            or not isinstance(test.get("run_attempt"), int) or test["run_attempt"] < 1):
        raise SystemExit("CI validation record is not clean and head-bound")
    validation_data = verify_file_record(
        {"path": test.get("evidence_path"), "sha256": test.get("evidence_sha256")},
        VALIDATION_PATH,
    )
    validation_text = validation_data.decode("utf-8")
    verify_ci_validation(test, head, validation_text, integrity if disposition is not None else None)
    if disposition is not None:
        verify_bootstrap_transport(disposition, validation_text)

    reviews = closure.get("reviews", [])
    if len(reviews) != 2 or {item.get("report_path") for item in reviews} != REVIEW_PATHS:
        raise SystemExit("two governed independent reviews are required")
    reviewers = set()
    checkpoints = set()
    for item in reviews:
        if (item.get("head") != head or item.get("critical") != 0 or item.get("important") != 0
                or item.get("reviewer") in reviewers or item.get("checkpoint") in checkpoints):
            raise SystemExit("closure review is not independent, clean, and head-bound")
        report_data = verify_file_record(
            {"path": item.get("report_path"), "sha256": item.get("report_sha256")},
            item.get("report_path"),
        )
        report = report_data.decode("utf-8")
        canonical_report = re.sub(r"(?m)^Checkpoint:.*\n?", "", report)
        expected_checkpoint = hashlib.sha256(canonical_report.encode()).hexdigest()
        expected_status = {
            "Reviewer:": "Reviewer: %s" % item["reviewer"],
            "HEAD:": "HEAD: `%s`" % head,
            "Critical:": "Critical: 0",
            "Important:": "Important: 0",
            "Checkpoint:": "Checkpoint: %s" % expected_checkpoint,
        }
        if item.get("checkpoint") != expected_checkpoint:
            raise SystemExit("closure review report is not checkpointed and head-bound")
        exact_status_lines(report, expected_status)
        reviewers.add(item["reviewer"])
        checkpoints.add(item["checkpoint"])

    reconciliation = closure.get("reconciliation", {})
    if (reconciliation.get("head") != head or reconciliation.get("critical") != 0
            or reconciliation.get("important") != 0 or reconciliation.get("result") != "pass"):
        raise SystemExit("reconciliation is not clean and head-bound")
    reconciliation_data = verify_file_record(
        {"path": reconciliation.get("path"), "sha256": reconciliation.get("sha256")},
        RECONCILIATION_PATH,
    )
    reconciliation_text = reconciliation_data.decode("utf-8")
    exact_status_lines(reconciliation_text, {
        "HEAD:": "HEAD: `%s`" % head,
        "Critical:": "Critical: 0",
        "Important:": "Important: 0",
    }, reconciliation=True)
    return 0


def main(argv):
    if len(argv) == 4 and argv[1] == "--validate-materialization-range":
        verify_materialization_range(argv[2], argv[3])
        return 0
    if len(argv) == 4 and argv[1] == "--validate-successor-head":
        verify_successor_head(argv[2], argv[3])
        return 0
    if len(argv) == 3 and argv[1] == "--validate-review-status":
        exact_status_lines(Path(argv[2]).read_text(encoding="utf-8"), {
            "Reviewer:": "Reviewer: reviewer-a",
            "HEAD:": "HEAD: `%s`" % ("a" * 40),
            "Critical:": "Critical: 0",
            "Important:": "Important: 0",
            "Checkpoint:": "Checkpoint: %s" % ("b" * 64),
        })
        return 0
    if len(argv) == 3 and argv[1] == "--validate-reconciliation-status":
        exact_status_lines(Path(argv[2]).read_text(encoding="utf-8"), {
            "HEAD:": "HEAD: `%s`" % ("a" * 40),
            "Critical:": "Critical: 0",
            "Important:": "Important: 0",
        }, reconciliation=True)
        return 0
    if len(argv) == 5 and argv[1] == "--validate-ci-record":
        test = json.loads(Path(argv[2]).read_text(encoding="utf-8"))
        validation_text = Path(argv[3]).read_text(encoding="utf-8")
        verify_ci_validation(test, argv[4], validation_text)
        return 0
    if len(argv) == 6 and argv[1] == "--validate-bootstrap-transport":
        disposition = json.loads(Path(argv[2]).read_text(encoding="utf-8"))
        validation_text = Path(argv[3]).read_text(encoding="utf-8")
        final = {"sha": argv[4], "tree": argv[5]}
        validate_bootstrap_disposition(disposition, final, argv[4])
        verify_bootstrap_transport(disposition, validation_text)
        return 0
    if len(argv) == 5 and argv[1] == "--generate":
        return generate(argv[2], argv[3], Path(argv[4]))
    if len(argv) == 4:
        materialization_head = argv[3]
        if git("rev-parse", "HEAD") != materialization_head:
            raise SystemExit("closure materialization must match the checked-out HEAD")
        result = validate(Path(argv[1]), argv[2])
        verify_materialization_range(argv[2], materialization_head)
        return result
    if len(argv) != 3:
        raise SystemExit("usage: validate-activation-closure CLOSURE.json ATTESTED_HEAD\n"
                         "   or: validate-activation-closure CLOSURE.json ATTESTED_HEAD MATERIALIZATION_HEAD\n"
                         "   or: validate-activation-closure --generate BASE HEAD RECORDS.json")
    return validate(Path(argv[1]), argv[2])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
