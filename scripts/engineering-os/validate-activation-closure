#!/usr/bin/env python3
"""Generate or validate the deterministic Mission #31 dependency closure."""
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))
from engineering_os.schema import validate_document

ROOT = Path(__file__).resolve().parents[2]
READY_SHA = "9996e5ebebd26b297e5ce57bcc4d4e78b01723d78052bea0b385a1ad5b95a9e0"
BASE_SHA = "c4cd413d0f77a9213bccb8f8f908dec0b292e41d"
AUTHORIZED_PATHS_SHA256 = "3f48fdb2ca302c30c3fdfd96caf13c88acee0cb28d257c91e55c2746d9c46e51"
CLOSURE_PATH = "docs/engineering-os/ACTIVATION_DEPENDENCY_CLOSURE.json"


def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT, text=True).strip()


def digest_at(revision, path):
    return hashlib.sha256(subprocess.check_output(["git", "show", "%s:%s" % (revision, path)], cwd=ROOT)).hexdigest()


def declaration_sha256():
    # The Ready event is the authority for this declaration.  The validator
    # never reads mutable issue exports or ambient worktree files.
    return "69f1acaee16c266ae727af7261c1ea8b33f0812c133cf9b730be71ec1561ab62"


def generate(base, head, records_path):
    """Emit canonical closure JSON; test/review claims come from explicit records."""
    records = json.loads(records_path.read_text(encoding="utf-8"))
    if set(records) != {"allowed_paths", "tests", "reviews"}:
        raise SystemExit("generation records must contain exactly allowed_paths, tests, and reviews")
    allowed = set(records.get("allowed_paths", []))
    if hashlib.sha256(json.dumps(sorted(allowed), separators=(",", ":")).encode()).hexdigest() != AUTHORIZED_PATHS_SHA256:
        raise SystemExit("generation scope does not match Mission 31 Ready authority")
    declaration_sha = declaration_sha256()
    changed = sorted(filter(None, git("diff", "--name-only", base, head).splitlines()))
    if not set(changed) <= allowed:
        raise SystemExit("implementation contains a path outside Mission 31 authority")
    evidence_paths = ("docs/engineering-os/ACTIVATION_INTEGRATION_SCOPE.md", "docs/engineering-os/EVIDENCE_AND_AUDIT.md")
    edges = []
    for test in sorted(path for path in changed if path.startswith("tests/")):
        for source in sorted(path for path in changed if not path.startswith("tests/")):
            edges.append({"from": test, "to": source, "kind": "tests"})
    pins = []
    pin_pattern = re.compile(r"josephmccann/AIFO-Control-Plane/.github/actions/materialize-kernel@([0-9a-f]{40})")
    for consumer in sorted(path for path in changed if path.startswith(".github/workflows/")):
        content = subprocess.check_output(["git", "show", "%s:%s" % (head, consumer)], cwd=ROOT, text=True)
        for sha in sorted(set(pin_pattern.findall(content))):
            pins.append({"consumer": consumer, "sha": sha})
    closure = {
        "schema_version": "1.0.0",
    "mission": {"repository": "josephmccann/AIFO-Control-Plane", "issue": 31,
                    "declaration_path": "outputs/successor-mission-declaration.md",
                    "declaration_sha256": declaration_sha, "ready_declaration_sha256": READY_SHA,
                    "allowed_paths": sorted(allowed)},
        "base": {"sha": base, "tree": git("rev-parse", "%s^{tree}" % base)},
        "final": {"sha": head, "tree": git("rev-parse", "%s^{tree}" % head)},
    "files": [{"path": path, "sha256": digest_at(head, path), "reason": "Mission 31 implementation"} for path in changed if path != CLOSURE_PATH],
        "edges": edges, "pins": pins, "tests": records["tests"],
        "evidence": [{"path": path, "sha256": digest_at(head, path)} for path in evidence_paths],
        "reviews": records["reviews"],
    }
    print(json.dumps(closure, sort_keys=True, indent=2))
    return 0


def validate(path, head):
    closure = json.loads(path.read_text(encoding="utf-8"))
    violations = validate_document("activation-closure", closure)
    if violations:
        raise SystemExit("activation closure schema rejected: " + "; ".join(item.code for item in violations))
    if set(closure) != {"schema_version", "mission", "base", "final", "files", "edges", "pins", "tests", "evidence", "reviews"}:
        raise SystemExit("closure top-level structure is not closed")
    mission = closure.get("mission", {})
    allowed = set(mission.get("allowed_paths", []))
    if hashlib.sha256(json.dumps(sorted(allowed), separators=(",", ":")).encode()).hexdigest() != AUTHORIZED_PATHS_SHA256:
        raise SystemExit("closure scope does not match Mission 31 Ready authority")
    declaration_sha = declaration_sha256()
    if mission != {"repository": "josephmccann/AIFO-Control-Plane", "issue": 31,
            "declaration_path": "outputs/successor-mission-declaration.md", "declaration_sha256": declaration_sha,
            "ready_declaration_sha256": READY_SHA, "allowed_paths": sorted(allowed)}:
        raise SystemExit("mission identity is not canonical")
    final = closure.get("final", {})
    if final.get("sha") != head or git("rev-parse", head) != head or final.get("tree") != git("rev-parse", "%s^{tree}" % head):
        raise SystemExit("closure final revision mismatch")
    base = closure.get("base", {})
    if base.get("sha") != BASE_SHA:
        raise SystemExit("closure base is not the Mission 31 rollback/base")
    if git("rev-parse", base.get("sha", "")) != base.get("sha") or git("rev-parse", "%s^{tree}" % base["sha"]) != base.get("tree"):
        raise SystemExit("closure base revision mismatch")
    changed = set(git("diff", "--name-only", base["sha"], head).splitlines()) - {CLOSURE_PATH}
    records = closure.get("files")
    if not isinstance(records, list) or {item.get("path") for item in records} != changed:
        raise SystemExit("closure file set is missing, extra, or stale")
    if not (changed | {CLOSURE_PATH}) <= allowed:
        raise SystemExit("closure contains a path outside Mission 31 authority")
    for item in records:
        if set(item) != {"path", "sha256", "reason"} or item["sha256"] != digest_at(head, item["path"]):
            raise SystemExit("closure file digest mismatch: %s" % item.get("path"))
    nodes = changed | {item.get("path") for item in closure.get("evidence", [])}
    expected_edges = []
    for test in sorted(item for item in changed if item.startswith("tests/")):
        for source in sorted(item for item in changed if not item.startswith("tests/")):
            expected_edges.append({"from": test, "to": source, "kind": "tests"})
    if closure.get("edges") != expected_edges:
        raise SystemExit("closure dependency edges are incomplete or contradictory")
    if not closure.get("edges"):
        raise SystemExit("closure dependency edges are empty")
    for edge in closure.get("edges", []):
        if set(edge) != {"from", "to", "kind"} or edge["from"] not in nodes or edge["to"] not in nodes:
            raise SystemExit("closure dependency edge is dangling")
    expected_pins = []
    pin_pattern = re.compile(r"josephmccann/AIFO-Control-Plane/.github/actions/materialize-kernel@([0-9a-f]{40})")
    for consumer in sorted(path for path in changed if path.startswith(".github/workflows/")):
        content = subprocess.check_output(["git", "show", "%s:%s" % (head, consumer)], cwd=ROOT, text=True)
        for sha in sorted(set(pin_pattern.findall(content))):
            expected_pins.append({"consumer": consumer, "sha": sha})
    if closure.get("pins") != expected_pins:
        raise SystemExit("closure transport pin set is missing, extra, or stale")
    if {item.get("path") for item in closure.get("evidence", [])} != {
        "docs/engineering-os/ACTIVATION_INTEGRATION_SCOPE.md", "docs/engineering-os/EVIDENCE_AND_AUDIT.md"}:
        raise SystemExit("closure evidence set is incomplete")
    for item in closure["evidence"]:
        if item["path"] not in changed or item["sha256"] != digest_at(head, item["path"]):
            raise SystemExit("closure evidence digest mismatch")
    if not closure.get("tests") or len(closure.get("reviews", [])) != 2:
        raise SystemExit("closure requires tests and two reviews")
    reviewers = set()
    report_paths = set()
    for collection in ("tests", "reviews"):
        for item in closure.get(collection, []):
            if item.get("head") != head or item.get("result", "pass") != "pass" or item.get("critical", 0) != 0 or item.get("important", 0) != 0:
                raise SystemExit("closure %s record is not clean and head-bound" % collection)
            evidence_path = item.get("evidence_path") if collection == "tests" else item.get("report_path")
            evidence_sha = item.get("evidence_sha256") if collection == "tests" else item.get("report_sha256")
            if not isinstance(evidence_path, str) or not isinstance(evidence_sha, str):
                raise SystemExit("closure %s record lacks durable evidence binding" % collection)
            if collection == "reviews":
                if not evidence_path.startswith("outputs/mission-31-review/") or ".." in Path(evidence_path).parts:
                    raise SystemExit("closure review evidence path is not governed")
                evidence_file = ROOT / evidence_path
                if not evidence_file.is_file():
                    raise SystemExit("closure review evidence is missing")
                try:
                    evidence_file.resolve().relative_to((ROOT / "outputs/mission-31-review").resolve())
                except ValueError:
                    raise SystemExit("closure review evidence escapes its governed directory")
                if hashlib.sha256(evidence_file.read_bytes()).hexdigest() != evidence_sha:
                    raise SystemExit("closure review evidence is stale")
                report = evidence_file.read_text(encoding="utf-8")
                reviewer_match = re.search(r"(?m)^Reviewer:\s*(\S+)\s*$", report)
                head_match = re.search(r"(?m)^HEAD:\s*`([0-9a-f]{40})`\s*$", report)
                checkpoint_match = re.search(r"(?m)^Checkpoint:\s*([0-9a-f]{64})\s*$", report)
                canonical_report = re.sub(r"(?m)^Checkpoint:.*\n?", "", report)
                expected_checkpoint = hashlib.sha256(canonical_report.encode()).hexdigest()
                if (len(re.findall(r"(?m)^Reviewer:\s*\S+\s*$", report)) != 1
                        or len(re.findall(r"(?m)^HEAD:\s*`[0-9a-f]{40}`\s*$", report)) != 1
                        or len(re.findall(r"(?m)^Checkpoint:\s*[0-9a-f]{64}\s*$", report)) != 1
                        or len(re.findall(r"(?m)^Critical:\s*[0-9]+\s*$", report)) != 1
                        or len(re.findall(r"(?m)^Important:\s*[0-9]+\s*$", report)) != 1
                        or len(re.findall(r"(?m)^PASS\s*$", report)) != 1
                        or reviewer_match is None or reviewer_match.group(1) != item.get("reviewer")
                        or head_match is None or head_match.group(1) != head
                        or checkpoint_match is None or checkpoint_match.group(1) != expected_checkpoint
                        or item.get("checkpoint") != expected_checkpoint
                        or re.search(r"(?m)^Critical:\s*0\s*$", report) is None
                        or re.search(r"(?m)^Important:\s*0\s*$", report) is None
                        or re.search(r"(?m)^PASS\s*$", report) is None
                        or re.search(r"(?m)^(?:Critical|Important):\s*[1-9]\d*\s*$", report) is not None
                        or re.search(r"(?m)^(?:FAIL|Verdict:\s*FAIL)\s*$", report) is not None):
                    raise SystemExit("closure review report is not head-bound")
            else:
                if item.get("command") not in {"validate-all", "focused-tests"}:
                    raise SystemExit("closure test command is not approved")
                if item.get("workflow_path") != ".github/workflows/mission-command.yml":
                    raise SystemExit("closure test workflow is not approved")
                if not isinstance(item.get("run_id"), int) or item["run_id"] < 1:
                    raise SystemExit("closure test run identity is invalid")
                if not isinstance(item.get("run_attempt"), int) or item["run_attempt"] < 1:
                    raise SystemExit("closure test run attempt is invalid")
                if not evidence_path.startswith("outputs/mission-31-validation/"):
                    raise SystemExit("closure test evidence is not bound to the attested revision")
                evidence_file = ROOT / evidence_path
                try:
                    evidence_file.resolve().relative_to((ROOT / "outputs/mission-31-validation").resolve())
                except ValueError:
                    raise SystemExit("closure test evidence escapes its governed directory")
                if not evidence_file.is_file() or hashlib.sha256(evidence_file.read_bytes()).hexdigest() != evidence_sha:
                    raise SystemExit("closure test evidence is missing or stale")
                evidence_text = evidence_file.read_text(encoding="utf-8")
                if (head not in evidence_text or "Validation complete" not in evidence_text
                        or "Command: %s" % item["command"] not in evidence_text
                        or "Run ID: %s" % item["run_id"] not in evidence_text
                        or "Run attempt: %s" % item["run_attempt"] not in evidence_text
                        or "Workflow: %s" % item["workflow_path"] not in evidence_text
                        or "Ran " not in evidence_text or "OK" not in evidence_text):
                    raise SystemExit("closure test evidence does not prove the requested head")
            if collection == "reviews":
                if item["reviewer"] in reviewers or evidence_path in report_paths:
                    raise SystemExit("closure reviews are not independent")
                reviewers.add(item["reviewer"])
                report_paths.add(evidence_path)
    if len(closure.get("reviews", [])) != 2 or len({item["checkpoint"] for item in closure["reviews"]}) != 2:
        raise SystemExit("two independent checkpointed reviews are required")
    return 0


def main(argv):
    if len(argv) == 5 and argv[1] == "--generate":
        return generate(argv[2], argv[3], Path(argv[4]))
    if len(argv) != 3:
        raise SystemExit("usage: validate-activation-closure CLOSURE.json ATTESTED_HEAD\n"
                         "   or: validate-activation-closure --generate BASE HEAD RECORDS.json")
    return validate(Path(argv[1]), argv[2])


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
