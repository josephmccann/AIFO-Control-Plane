#!/usr/bin/env bash
set -euo pipefail
exec python3 - "$@" <<'PY'
"""Generate aggregate Engineering OS metrics from a closed JSON document."""

import argparse
import json

from engineering_os.metrics import project_metrics


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("input_file")
    parser.add_argument("output_file")
    args = parser.parse_args()
    try:
        with open(args.input_file, encoding="utf-8") as handle:
            value = json.load(handle)
        if not isinstance(value, dict) or set(value) != {
            "events", "evidence_manifests", "period_start", "period_end",
        }:
            raise ValueError("input is not closed")
        metrics = project_metrics(
            value["events"],
            value["evidence_manifests"],
            period_start=value["period_start"],
            period_end=value["period_end"],
        )
        with open(args.output_file, "w", encoding="utf-8") as handle:
            json.dump(metrics, handle, sort_keys=True, separators=(",", ":"))
            handle.write("\n")
        return 0
    except (OSError, TypeError, ValueError, json.JSONDecodeError):
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
PY
