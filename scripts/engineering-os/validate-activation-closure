    for prefix, expected in expected_fields.items():
        if [line for line in evidence_lines if line.startswith(prefix)] != [expected]:
            raise SystemExit("CI evidence contains a missing, duplicate, or contradictory status")
    terminal_lines = [line for line in evidence_lines if line.startswith("Expected terminal:")]
    if terminal_lines != ([] if expected_terminal is None else [expected_terminal]):
        raise SystemExit("CI evidence terminal status is missing, duplicated, or contradictory")
