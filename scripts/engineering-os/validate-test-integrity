#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_root"
exec python3 -c '
import argparse
import hashlib
import json
import re
import subprocess
from dataclasses import asdict
from datetime import datetime, timezone
from pathlib import Path

from engineering_os.schema import validate_document
from engineering_os.test_integrity import analyze_test_integrity, validate_test_override

parser = argparse.ArgumentParser(description="Generate a delta-based EOS test-integrity report")
parser.add_argument("--base-root", required=True)
parser.add_argument("--head-root", required=True)
parser.add_argument("--base-sha", required=True)
parser.add_argument("--head-sha", required=True)
parser.add_argument("--repository", required=True)
parser.add_argument("--base-policy", required=True)
parser.add_argument("--evaluated-at")
parser.add_argument("--reviewer-identity", action="append", default=[])
parser.add_argument("--override")
parser.add_argument("--review")
parser.add_argument("--approval")
parser.add_argument("--output", required=True)
args = parser.parse_args()

if re.fullmatch(r"[0-9a-f]{40}", args.base_sha) is None or re.fullmatch(r"[0-9a-f]{40}", args.head_sha) is None:
    raise SystemExit("base and head SHA must be exact lowercase commit identifiers")
if re.fullmatch(r"[^/]+/[^/]+", args.repository) is None:
    raise SystemExit("repository must be owner/name")

base = Path(args.base_root).resolve(strict=True)
head = Path(args.head_root).resolve(strict=True)
if base == head:
    raise SystemExit("base and head checkout paths must differ")

def git(root, *values):
    return subprocess.run(
        ["git", "-C", str(root), *values], check=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE,
    ).stdout

def authenticated_manifest(root, expected_sha):
    actual = git(root, "rev-parse", "--verify", "HEAD^{commit}").decode("ascii").strip()
    if actual != expected_sha:
        raise SystemExit("checkout HEAD does not match authenticated event SHA")
    names_raw = git(root, "ls-tree", "-r", "--name-only", "-z", expected_sha)
    if names_raw and not names_raw.endswith(b"\0"):
        raise SystemExit("incomplete NUL-delimited git tree evidence")
    names = [item.decode("utf-8") for item in names_raw.split(b"\0") if item]
    if len(names) != len(set(names)):
        raise SystemExit("duplicate path in git tree evidence")
    manifest = {}
    for name in names:
        path = root / name
        if not path.is_file() or path.is_symlink():
            raise SystemExit("checkout is incomplete or contains unsupported links")
        manifest[name] = hashlib.sha256(path.read_bytes()).hexdigest()
    disk = {
        path.relative_to(root).as_posix()
        for path in root.rglob("*")
        if path.is_file() and ".git" not in path.relative_to(root).parts
    }
    if disk != set(names):
        raise SystemExit("checkout contains missing or untracked source evidence")
    return manifest

base_manifest = authenticated_manifest(base, args.base_sha)
head_manifest = authenticated_manifest(head, args.head_sha)
with open(args.base_policy, encoding="utf-8") as handle:
    repository_policy = json.load(handle)
violations = validate_document("repository-policy", repository_policy)
if violations:
    raise SystemExit("base repository policy is invalid: %s" % violations[0].code)
if repository_policy["repository"] != args.repository:
    raise SystemExit("base repository policy does not match authenticated repository")

evaluated_at = args.evaluated_at or datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")
analysis_policy = {
    "schema_version": "1.0.0",
    "repository": args.repository,
    "base_sha": args.base_sha,
    "head_sha": args.head_sha,
    "evaluated_at": evaluated_at,
    "base_manifest": base_manifest,
    "head_manifest": head_manifest,
    "founder_identities": repository_policy["founder_identities"],
    "reviewer_identities": args.reviewer_identity or ["__unassigned_adversary__"],
    "configuration": {
        "test_globs": [
            "tests/**/test_*.py", "tests/**/*.test.js", "tests/**/*.spec.js",
            "tests/**/*.test.ts", "tests/**/*.spec.ts",
        ],
        "fixture_globs": ["tests/**/fixtures/**", "test/**/fixtures/**"],
        "validation_workflow_globs": [
            ".github/workflows/*validate*.yml", ".github/workflows/*test*.yml",
            ".github/workflows/*ci*.yml",
        ],
        "test_config_globs": [
            "pyproject.toml", "pytest.ini", "setup.cfg", "tox.ini", "package.json",
            "*vitest*.js", "*vitest*.ts", "*jest*.js", "*jest*.ts",
        ],
        "coverage_paths": ["coverage.json", "coverage-summary.json", ".eos/coverage.json"],
        "material_coverage_decline": 1.0,
        "assertion_patterns": [r"\bassert\b", r"\bexpect\s*\(", r"\.assert[A-Z]\w*\s*\("],
        "skip_patterns": [r"\bskip(?:If|Unless|Test)?\b", r"\.(?:skip|todo|disabled)\b", r"\bdisabled\b"],
    },
}
report = analyze_test_integrity(base, head, analysis_policy)
document = report.to_dict()
allowed = report.allowed
if args.override:
    load = lambda path: json.load(open(path, encoding="utf-8")) if path else None
    decision = validate_test_override(report, load(args.override), load(args.review), load(args.approval))
    document = {"report": document, "override_decision": asdict(decision)}
    allowed = decision.allowed
elif args.review or args.approval:
    raise SystemExit("review and approval require an override")
output = Path(args.output)
output.parent.mkdir(parents=True, exist_ok=True)
output.write_text(json.dumps(document, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8")
raise SystemExit(0 if allowed else 1)
' "$@"
